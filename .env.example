# ==============================================================================
# Recipe Step Autocompleter Configuration
# ==============================================================================

# LLM Provider Configuration (Optional)
# Options: ollama, gemini, groq, none
# The tool operates primarily as an n-gram statistical language model.
# LLM integration provides hybrid assistance, completions, and comparison.
LLM_PROVIDER=none

# --- Option A: Gemini (Google AI Studio free tier) ---
# Get a free key at: https://aistudio.google.com/
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.0-flash

# --- Option B: Groq (Ultra-fast cloud inference with free tier) ---
# Get a free key at: https://console.groq.com/
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.1-8b-instant

# --- Option C: Ollama (Local laptop model) ---
# Install Ollama from: https://ollama.com/
# Run: ollama run llama3.2 or ollama run mistral
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL_NAME=llama3.2

# --- N-Gram Model Defaults ---
DEFAULT_N=3
DEFAULT_SMOOTHING=laplace
DEFAULT_SUGGESTION_LENGTH=10
DEFAULT_NUM_SUGGESTIONS=3
